# Copy this file to .env (or .env.production) and adjust once you have
# your real MQTT broker details. Vite only exposes variables prefixed
# with VITE_ to the browser bundle.

# Browsers can't open raw mqtt:// TCP sockets — mqtt.js needs a
# WebSocket URL (ws:// or wss://). If your broker only exposes a plain
# mqtt://host:1883 listener, ask whoever runs the broker to also expose
# a websocket listener (commonly on port 8083 for ws, 8084 for wss),
# or put an MQTT-over-WebSocket proxy in front of it.
VITE_MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt

# Current test topic. Once each room has its own controller, use a
# template like "zvw/rooms/{room}/state" — {room} is substituted with
# the tablet's room id automatically.
VITE_MQTT_TOPIC=tania/fakeplc/data

# Optional broker auth
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Default room id used only when no ?room= query param is present
# (handy for local development).
VITE_DEFAULT_ROOM=OG-001
